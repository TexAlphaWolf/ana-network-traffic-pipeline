# Copy to .env and fill in. .env is ignored by Git: never commit it.
# Choose long random values, for example: openssl rand -base64 24

# ClickHouse user that flowpipe writes with
CLICKHOUSE_FLOWPIPE_PASSWORD=
# Read-only ClickHouse user that Grafana uses
GRAFANA_CLICKHOUSE_PASSWORD=
# Grafana web login (user: admin)
GRAFANA_ADMIN_PASSWORD=

# Days of flow data to keep (older rows are deleted by ClickHouse)
FLOWPIPE_RETENTION_DAYS=90

# Linux only: run the command-line container as you, so files in ./captures belong to you.
# FLOWPIPE_USER=1000:1000

# Optional: replace every IP address with a keyed pseudonym before storing (8+ characters).
# Useful for data you want to share or publish. Keep the key secret.
FLOWPIPE_ANONYMISE_KEY=

# NetFlow/IPFIX collector (docker compose --profile netflow up -d)
# Only these exporters are accepted: your router's address, or a range (192.168.0.1).
FLOWPIPE_ALLOWED_EXPORTERS=
# On a machine with several networks you can bind the UDP port to one address.
# FLOWPIPE_COLLECTOR_BIND=192.168.0.20
